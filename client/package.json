{
  "name": "@signprint/client",
  "version": "0.0.1",
  "description": "Browser client for signprint: challenge runner and request signer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C00LVansh/signprint.git",
    "directory": "client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:browser": "playwright test",
    "bundle": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/signprint.js --sourcemap"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  }
}
